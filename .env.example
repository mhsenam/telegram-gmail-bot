# ============================================================================
#  Gmail Super Bot — environment configuration
#  Copy this file to ".env" and fill in real values. NEVER commit ".env".
#  See SETUP.md for where each value comes from.
# ============================================================================

# --- Telegram (from @BotFather) ---------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth client (Google Cloud Console -> Credentials) --------------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL where THIS app's OAuth callback is reachable.
# Local testing:   http://localhost:8080
# Production:      https://yourdomain.com   (MUST be https, MUST be public)
# The redirect URI registered in Google must be: <this value>/oauth2callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# --- Web server (the OAuth callback listener) -------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Encryption key for Gmail tokens at rest --------------------------------
# Generate ONE and keep it secret & stable (changing it invalidates all stored
# accounts). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=PASTE_A_GENERATED_FERNET_KEY_HERE

# --- Behaviour --------------------------------------------------------------
# How often (seconds) to check every connected inbox for new mail.
POLL_INTERVAL_SECONDS=30

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL blank to use a local SQLite file (great for dev).
# Set DATABASE_URL to use PostgreSQL instead (REQUIRED for Replit/production, since
# SQLite is wiped on redeploy). Replit's built-in Postgres sets this for you.
#   e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# SQLite database file path (used only when DATABASE_URL is blank).
DATABASE_PATH=gmail_bot.db

# --- Networking (optional) --------------------------------------------------
# If api.telegram.org is blocked on your network, route Telegram traffic through
# a proxy instead of needing a system-wide VPN. Leave blank to connect directly.
#   HTTP proxy:   http://127.0.0.1:8080
#   SOCKS5 proxy: socks5://127.0.0.1:1080   (requires httpx[socks], already in requirements)
TELEGRAM_PROXY=

# Connection timeout (seconds) when talking to Telegram. Raise on slow networks.
TELEGRAM_CONNECT_TIMEOUT=20
